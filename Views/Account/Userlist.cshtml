@model IEnumerable<test.Models.User>


@{
    ViewData["Title"] = "User List";
}

<div class="container mt-4">
    <h2>รายชื่อผู้ใช้งานทั้งหมด (User List)</h2>

   
    <a asp-action="Register" asp-controller="Account" class="btn btn-success mb-3">
        + เพิ่มผู้ใช้งานใหม่
    </a>

    <table class="table table-bordered table-striped">
        <thead class="thead-dark">
            <tr>
                <th>รหัสผู้ใช้ (User ID)</th>
                <th>ชื่อผู้ใช้ (Username)</th>
                <th>อีเมล (Email)</th>
                <th>สิทธิ์ผู้ใช้งาน (Role)</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                // ใช้ลูป foreach เพื่อดึงข้อมูลแต่ละรายการในฐานข้อมูลมาแสดงทีละแถว
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.UserId</td>
                        <td>@user.Username</td>
                        <td>@user.Email</td>
                        <td>@user.Role</td>
                    </tr>
                }
            }
            else
            {
                // ถ้าฐานข้อมูลยังว่างเปล่า ให้แสดงข้อความนี้
                <tr>
                    <td colspan="4" class="text-center text-muted">ยังไม่มีข้อมูลผู้ใช้งานในระบบ</td>
                </tr>
            }
        </tbody>
    </table>
</div>