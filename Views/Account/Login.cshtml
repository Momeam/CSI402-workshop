@model Easystay.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "เข้าสู่ระบบ | Easy Stay";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="text-center mb-4">
                <h2 class="fw-bold text-primary">Easy Stay</h2>
                <h5>ยินดีต้อนรับสู่ Easy Stay</h5>
                <p class="text-muted">เข้าสู่ระบบเพื่อจัดการการจองและสิทธิพิเศษของคุณ</p>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-white p-0 border-bottom-0">
                    <ul class="nav nav-tabs nav-justified" id="loginTabs">
                        <li class="nav-item">
                            <a class="nav-link active fw-bold" href="#">สำหรับลูกค้า</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-muted" href="#">สำหรับพนักงาน</a>
                        </li>
                    </ul>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Account" asp-action="Login" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-bold">อีเมลผู้ใช้งาน</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="thailand.traveler@gmail.com">
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">รหัสผ่าน</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="••••••••">
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMe">
                                <label class="form-check-label text-muted" for="rememberMe">จดจำฉัน</label>
                            </div>
                            <a href="#" class="text-decoration-none text-primary">ลืมรหัสผ่าน?</a>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 mb-3 fw-bold">เข้าสู่ระบบ</button>
                        
                        <div class="text-center text-muted mb-3">หรือเข้าสู่ระบบด้วย</div>
                        
                        <button type="button" class="btn btn-outline-dark w-100 py-2 fw-bold">
                            <i class="bi bi-google me-2"></i> เข้าสู่ระบบด้วย Google
                        </button>
                    </form>
                </div>
            </div>
            
            <div class="text-center mt-4">
                <a asp-controller="Account" asp-action="Register" class="text-decoration-none text-primary fw-bold">ยังไม่มีบัญชี Easy Stay? สมัครสมาชิกใหม่</a>
            </div>
        </div>
    </div>
</div>