@model test.Models.User 


@{
    ViewData["Title"] = "Register";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white text-center">
                    <h3 class="mb-0">สมัครสมาชิก (Register)</h3>
                </div>
                <div class="card-body">

                    @if (ViewBag.Status != null)
                    {
                        <div class="alert alert-danger text-center">
                            <strong>แจ้งเตือน:</strong> @ViewBag.Status
                        </div>
                    }

                   
                    <form asp-action="Register" asp-controller="Account" method="post">
                        
                        <div class="form-group mb-3">
                            <label asp-for="UserId" class="form-label font-weight-bold">รหัสผู้ใช้งาน (User ID)</label>
                            <input asp-for="UserId" class="form-control" placeholder="ตั้งรหัสผู้ใช้งานของคุณ" required />
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Username" class="form-label font-weight-bold">ชื่อผู้ใช้งาน (Username)</label>
                            <input asp-for="Username" class="form-control" placeholder="ตั้งชื่อผู้ใช้งาน" required />
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Email" class="form-label font-weight-bold">อีเมล (Email)</label>
                            <input type="email" asp-for="Email" class="form-control" placeholder="example@email.com" required />
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="PasswordHash" class="form-label font-weight-bold">รหัสผ่าน (Password)</label>
                            <input type="password" asp-for="PasswordHash" class="form-control" placeholder="ตั้งรหัสผ่านของคุณ" required />
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-block">ยืนยันการสมัครสมาชิก</button>
                        </div>
                        
                    </form>

                    <!-- ลิงก์กลับไปหน้า Login (ถ้ามี) -->
                    <div class="text-center mt-3">
                        <p>มีบัญชีอยู่แล้ว? <a asp-action="Login" asp-controller="Account">เข้าสู่ระบบที่นี่</a></p>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>