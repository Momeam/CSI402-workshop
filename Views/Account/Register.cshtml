@model Easystay.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "สมัครสมาชิก | Easy Stay";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="text-center mb-4">
                <h2 class="fw-bold text-primary">Easy Stay</h2>
                <h5>สร้างบัญชีใหม่</h5>
                <p class="text-muted">สมัครสมาชิกเพื่อรับสิทธิพิเศษและโปรโมชั่นที่ดีที่สุด</p>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form asp-controller="Account" asp-action="Register" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-bold">ชื่อ-นามสกุล</label>
                            <input asp-for="Fullname" type="text" class="form-control" placeholder="ระบุชื่อและนามสกุลของคุณ">
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">อีเมล</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="example@email.com">
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">เบอร์โทรศัพท์</label>
                            <input asp-for="PhoneNumber" type="tel" class="form-control" placeholder="08x-xxx-xxxx">
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">รหัสผ่าน</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="ตั้งรหัสผ่านอย่างน้อย 8 ตัวอักษร">
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">ยืนยันรหัสผ่าน</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="กรอกรหัสผ่านอีกครั้ง">
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">ยืนยันการสมัคร</button>
                    </form>
                </div>
            </div>
            
            <div class="text-center mt-4">
                <span class="text-muted">มีบัญชีผู้ใช้แล้ว?</span> 
                <a asp-controller="Account" asp-action="Login" class="text-decoration-none text-primary fw-bold">เข้าสู่ระบบ</a>
            </div>
        </div>
    </div>
</div>